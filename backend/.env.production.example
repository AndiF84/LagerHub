# ============================================================================
# LagerHub – Vorlage fuer die .env auf dem Firmenserver
#
# Auf dem Server nach backend\.env kopieren und ausfuellen. Die Datei enthaelt
# Geheimnisse und gehoert NICHT ins Repo (.gitignore deckt .env ab).
#
# Unterschiede zur Entwicklungs-.env sind unten jeweils vermerkt.
# ============================================================================

# --- Betriebsmodus ---------------------------------------------------------
NODE_ENV=production

# Zeitzone. Scheduler (Feierabend, Arbeitsbeginn, Eskalation, Mittagspause) und
# die Tagesgrenzen der Statistik rechnen mit der LOKALEN Zeit des Prozesses.
# Steht der Server auf UTC, unterbricht der Feierabend im Sommer zwei Stunden zu
# spaet und Tagesjournale schneiden am falschen Punkt. Die Server-Zeitzone soll
# ohnehin Europe/Berlin sein – diese Zeile ist die Absicherung, falls nicht.
TZ=Europe/Berlin

# --- Netzwerk --------------------------------------------------------------
PORT=3000
# Nur ueber localhost erreichbar. Der Dienst spricht unverschluesseltes HTTP;
# nach aussen geht ausschliesslich IIS mit TLS. Auf 0.0.0.0 gesetzt waere die
# API samt Bearer-Token im Klartext im Firmennetz erreichbar und das HTTPS der
# beiden Websites umgehbar. NICHT aendern.
HOST=localhost

# --- Datenbank (lokales PostgreSQL auf demselben Server) --------------------
# Gegenueber der Entwicklung entfallen die Supabase-Pooler-Parameter:
# kein pgbouncer=true, kein connection_limit=1 (das war die Ursache dafuer,
# dass gleichzeitige Anfragen sich gegenseitig ausgebremst haben).
DATABASE_URL="postgresql://lagerhub:[PASSWORT]@localhost:5432/lagerhub"
# Fuer `prisma migrate deploy`. Lokal ist das dieselbe Verbindung.
DIRECT_URL="postgresql://lagerhub:[PASSWORT]@localhost:5432/lagerhub"

# --- Auth ------------------------------------------------------------------
# NEU erzeugen, nicht aus der Entwicklung uebernehmen:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Beim Aendern werden alle ausgestellten Tokens ungueltig (alle melden sich neu an).
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Erlaubte Origins, kommagetrennt – die beiden Website-Adressen. Leer lassen
# heisst "jeden Origin spiegeln"; der Server warnt beim Start, wenn das in
# Produktion passiert.
CORS_ORIGIN="https://lagerhub.firma.de,https://lagerhub-app.firma.de"

# Geheime PINs fuer die Dashboard-Vollansicht (Rolle ADMIN). Format "PIN:Name",
# mehrere mit Komma. NEU vergeben – die Entwicklungs-PINs gelten als
# kompromittiert (sie standen einmal im Quelltext, siehe CLAUDE.md).
# Wird beim Start EINMAL gelesen: eine Aenderung wirkt erst nach Neustart des Dienstes.
ADMIN_PINS="[PIN]:[Name]"

# --- Web Push (VAPID) ------------------------------------------------------
# Mit `npx web-push generate-vapid-keys` erzeugen. Werden die Schluessel spaeter
# ausgetauscht, sind alle gespeicherten Abos ungueltig und jedes Handy muss Push
# neu aktivieren – also einmal erzeugen und behalten.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Kontaktadresse fuer die Push-Dienste, echte Mailadresse.
VAPID_SUBJECT="mailto:it@firma.de"

# --- Zeiterfassung (Crewmeister, optional) ---------------------------------
# Fehlt die Konfiguration, laeuft LagerHub weiter – dann gibt es aber keinen
# Anwesenheits-Sync (die Regel "Ausstempeln unterbricht die Arbeit" faellt aus)
# und die Auswertung "inaktive Zeit" bleibt leer.
CREWMEISTER_BASE_URL="https://api.crewmeister.com"
CREWMEISTER_USER=""
CREWMEISTER_PASSWORD=""
CREWMEISTER_CREW_ID=""
