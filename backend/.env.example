# --- Datenbank: lokale PostgreSQL 17 ---------------------------------------
# Beide URLs zeigen auf dieselbe Verbindung. Kein pgbouncer, kein
# connection_limit=1, kein sslmode – die Verbindung verlässt den Rechner nicht.
# Angelegt werden Rolle und Datenbank einmalig mit:
#   psql -U postgres -c "CREATE ROLE lagerhub LOGIN PASSWORD '…';"
#   psql -U postgres -c "CREATE DATABASE lagerhub OWNER lagerhub ENCODING 'UTF8';"
DATABASE_URL="postgresql://lagerhub:[PASSWORT]@localhost:5432/lagerhub"
DIRECT_URL="postgresql://lagerhub:[PASSWORT]@localhost:5432/lagerhub"

# --- Rückweg: Supabase-Cloud (bis 07.09.2026 in Benutzung) ------------------
# Nur falls die DB wieder in die Cloud soll. sslmode=require ist dort Pflicht:
# Prismas Default "prefer" fällt bei einem gestörten TLS-Handshake STILL auf
# Klartext zurück, und die Strecke geht übers offene Internet.
# Der Transaction-Pooler (6543) verlangt pgbouncer=true + connection_limit=1;
# prisma migrate braucht den Session-Pooler (5432, IPv4) – die echte
# Direktverbindung db.[PROJECT-REF].supabase.co ist IPv6-only.
#DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

PORT=3000
# Bind-Adresse. Default "localhost": das Backend spricht unverschluesseltes HTTP
# und soll nur vom Proxy davor erreichbar sein (Vite im Dev, IIS in Produktion),
# nicht aus dem Netz. Nur bewusst aendern (z. B. HOST=0.0.0.0).
#HOST=localhost

# JWT-Secret für die API-Auth (Pflicht – Server startet sonst nicht). Langer
# Zufallswert, z. B. mit `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
# Beim Ändern werden alle ausgestellten Tokens ungültig (alle müssen sich neu anmelden).
JWT_SECRET=""
# Optional: Token-Laufzeit (Default 12h). Formate wie "12h", "1d", "30m".
JWT_EXPIRES_IN="12h"
# Optional: erlaubte CORS-Origins (kommagetrennt), z. B. "https://lager.firma.de".
# Ohne Angabe wird jeder Origin gespiegelt (Dev-Komfort; in Prod same-origin).
CORS_ORIGIN=""

# Geheime Admin-PINs für die Dashboard-Vollansicht (Rolle ADMIN) – KEIN MA-Datensatz.
# Format je Eintrag "<4-stellige PIN>:<Anzeigename>", mehrere mit Komma getrennt.
# Beispiel: ADMIN_PINS="1234:Admin,5678:Chef"
ADMIN_PINS=""

# Web Push (VAPID) – mit `npx web-push generate-vapid-keys` erzeugen
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID-Subject: mailto: oder https-URL (Pflicht für web-push)
VAPID_SUBJECT="mailto:admin@example.com"

# Crewmeister Zeiterfassung (v3-API) – für MA-Detail-Auswertung (echte Arbeitszeit)
# Auth: POST /api/v3/auth/user/ {username,password} -> JWT (Bearer). Stage: api.crewmeister-stage.com
CREWMEISTER_BASE_URL="https://api.crewmeister.com"
CREWMEISTER_USER=""
CREWMEISTER_PASSWORD=""
# crewId aus GET /api/v3/platform-app/crews
CREWMEISTER_CREW_ID=""
